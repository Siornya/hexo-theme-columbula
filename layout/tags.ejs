<div class="archive-layout">
  <div class="glass archive-card">
    <h1 class="archive-heading">标签</h1>
    <p class="archive-count">共 <%= site.tags.length %> 个标签 · <%= site.posts.length %> 篇文章</p>

    <%
      /* 按文章数量映射字号，做出标签云效果 */
      let counts = [];
      site.tags.each(function(t){ counts.push(t.length); });
      const maxC = counts.length ? Math.max.apply(null, counts) : 1;
      const minC = counts.length ? Math.min.apply(null, counts) : 1;
      const minF = 13, maxF = 24;
    %>

    <div class="tagcloud-wrap">
      <% site.tags.sort('name').each(function(tag){ %>
        <%
          const ratio = maxC === minC ? 1 : (tag.length - minC) / (maxC - minC);
          const size  = (minF + ratio * (maxF - minF)).toFixed(1);
        %>
        <a class="tagcloud-item" href="<%- url_for(tag.path) %>" style="font-size:<%= size %>px">
          <%= tag.name %><span class="tagcloud-count"><%= tag.length %></span>
        </a>
      <% }) %>
    </div>

    <% if (site.tags.length === 0) { %>
      <p class="taxo-empty">暂无标签</p>
    <% } %>
  </div>
</div>
